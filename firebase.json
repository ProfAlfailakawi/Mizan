{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "site": "mizan-f2ce3",
      "public": "firebase-hosting",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/:path*",
          "destination": "https://mizan-quran.web.app/:path*",
          "type": 302
        },
        {
          "source": "/",
          "destination": "https://mizan-quran.web.app/",
          "type": 302
        }
      ]
    },
    {
      "site": "mizan-quran",
      "public": "firebase-hosting",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "mizan",
            "region": "me-central1"
          }
        }
      ]
    }
  ]
}
