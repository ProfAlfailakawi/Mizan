{
  "name": "mizan-quran-competition-operating-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run verify:pwa && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run secret-scan && npm run source-audit && npm run lint && npm run test && npm run build",
    "secret-scan": "node scripts/scan-secrets.mjs",
    "source-audit": "node scripts/source-audit.mjs",
    "arabic-ui-audit": "node scripts/arabic-ui-audit.mjs",
    "waqf:derive": "tsx scripts/kfgqpc-waqf-derive.ts",
    "quran:science-intake": "tsx scripts/kfgqpc-science-intake.ts",
    "quran:readiness": "tsx scripts/quran-intelligence-readiness.ts",
    "verify:pwa": "node scripts/verify-pwa.mjs"
  },
  "engines": {
    "node": ">=22.20.0 <23",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
