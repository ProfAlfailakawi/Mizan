+          </div>
+        </div>
+
+        {/* living mushaf */}
+        <div className="font-quran self-center text-center" dir="rtl" style={{ fontSize: 'clamp(19px,5.4vw,38px)', lineHeight: 1.95, overflowWrap: 'anywhere', maxWidth: '100%', textShadow: '0 1px 0 rgba(0,0,0,.3)' }}>
