# MIZAN local / deployment configuration. Never commit real secrets.
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Google / Firebase (tenant identity and cloud persistence)
FIREBASE_PROJECT_ID=""
FIRESTORE_DATABASE_ID="(default)"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Server-side AI. AI is advisory and never part of the score critical path.
GEMINI_API_KEY=""

# Enterprise API key for server-to-server connectors/webhook testing.
MIZAN_ENTERPRISE_API_KEY=""

# Provider references — configure through a secret manager in production.
EMAIL_PROVIDER_SECRET_REF=""
SMS_PROVIDER_SECRET_REF=""
WHATSAPP_PROVIDER_SECRET_REF=""
IDENTITY_PROVIDER_SECRET_REF=""
CERTIFICATE_SIGNING_KEY_REF=""
OBJECT_STORAGE_SECRET_REF=""

# Development-only role preview. Never enable in production.
VITE_ENABLE_ROLE_PREVIEW="false"

# Production signed credentials
MIZAN_PASS_SIGNING_SECRET=
MIZAN_CERT_SIGNING_SECRET=
MIZAN_WEBHOOK_SIGNING_SECRET=
MIZAN_WEBHOOK_ALLOW_HOSTS=

# Optional external providers (server-side only)
MIZAN_EMAIL_PROVIDER_URL=
MIZAN_EMAIL_PROVIDER_TOKEN=
MIZAN_SMS_PROVIDER_URL=
MIZAN_SMS_PROVIDER_TOKEN=
MIZAN_WHATSAPP_PROVIDER_URL=
MIZAN_WHATSAPP_PROVIDER_TOKEN=
MIZAN_PUSH_PROVIDER_URL=
MIZAN_PUSH_PROVIDER_TOKEN=
MIZAN_COPILOT_URL=
MIZAN_COPILOT_TOKEN=
MIZAN_AI_INTEGRITY_URL=
MIZAN_AI_INTEGRITY_TOKEN=

# Trust / Federation signing (server-side only). Store the PEM in a secret manager.
# For env-file based local development, encode PEM newlines as \\n.
MIZAN_TRUST_SIGNING_PRIVATE_KEY_PEM=
MIZAN_TRUST_KEY_ID=

# Durable local Edge relay. Point to an encrypted/persistent local volume on the Edge host.
MIZAN_EDGE_DATA_DIR=

# Browser BroadcastChannel mesh is a same-origin development adapter, not a cross-device field transport.
VITE_ENABLE_BROWSER_MESH_ADAPTER=false

# Production Question Escrow — keep Quran question plaintext off JudgeOS until presence + panel quorum.
# MASTER_KEY must decode to exactly 32 bytes (base64url or 64 hex chars).
# Store both values in a production secret manager; use an encrypted persistent volume for DIR.
MIZAN_QUESTION_ESCROW_DIR=
MIZAN_QUESTION_ESCROW_MASTER_KEY=

# High-value competition identity protection. Keep true unless an equivalent enterprise IdP policy enforces MFA upstream.
# Both browser and server enforce this for privileged roles.
VITE_REQUIRE_MFA_FOR_SENSITIVE=true
MIZAN_REQUIRE_MFA_FOR_SENSITIVE=true

# Server-side named-account governance repository (no passwords are stored by MIZAN).
# Use an encrypted persistent volume. For multi-node production, replace the single-node file repository with a transactional shared store.
MIZAN_IDENTITY_GOVERNANCE_DIR=
# Persistent in-app notification center. Defaults to <identity-dir>/notifications when omitted.
MIZAN_NOTIFICATION_CENTER_DIR=

# Measured word timings for reference recitation highlighting.
# Indexed by RECORDING id (e.g. hafs-muaiqly), never by reciter name: timings measured on one
# recording drift when served against another master of the same reciter. Absent = the reader
# falls back to the marked proportional estimate, which is the default.
#   node scripts/word-timing-acquire.mjs --layout <mushaf-layout-dir> --out <dir>
# then write <dir>/manifest.json mapping recording id -> timing file, by hand and deliberately.
MIZAN_WORD_TIMINGS_DIR=

# Server-side integrity authority: quorum lifecycle and FairDraw commit/reveal seeds.
# MUST be a durable, shared path. On Cloud Run the container filesystem is per-instance and
# erased on restart, so an unrevealed draw seed would be lost and two instances would disagree
# about who approved what — the server refuses to enable the authority on such a path.
# Mount a volume and point this at it. Set _DURABLE=true only when the path really is backed
# by shared persistent storage. Generate the signing key with:
#   node scripts/setup-integrity-authority.mjs
MIZAN_INTEGRITY_AUTHORITY_DIR=
MIZAN_INTEGRITY_AUTHORITY_DURABLE=false

# Append-only hash-chained evidence ledger for critical competition actions.
# Use an encrypted persistent volume; for multi-node deployment use a transactional/WORM-capable shared backend.
MIZAN_AUDIT_LEDGER_DIR=

# Server-side certified Quran source vault + Silent Question Capsule
# Persist official KFGQPC bundle manifests and certified Quran verse payloads outside JudgeOS.
MIZAN_QURAN_SOURCE_DIR=./.mizan-data/quran-sources
# Server-held FairDraw question pool blueprints. Judge clients never receive this pool in production.
MIZAN_SERVER_QUESTION_POOL_DIR=./.mizan-data/question-pools
# Server-side FairDraw runtime state. Plaintext questions remain encrypted until presence + panel quorum.
MIZAN_SECURE_QUESTION_RUNTIME_DIR=./.mizan-data/question-runtime

# Optional verified local KFGQPC visual assets. Page layout: <root>/<packageId>/<page>.webp|png|svg
MIZAN_KFGQPC_PAGE_IMAGE_ROOT=
# Optional verified KFGQPC Quran font asset: <root>/<packageId>.woff2|woff|ttf
MIZAN_KFGQPC_FONT_ROOT=
# Optional verified local ayah-audio cache: <root>/<readingId>/<surah>/<ayah>.mp3|m4a
MIZAN_KFGQPC_AUDIO_ROOT=

# Cloudflare R2 private delivery. NEVER prefix these with VITE_.
# In Cloud Run, ACCESS_KEY_ID and SECRET_ACCESS_KEY must be Secret Manager references, not committed values.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://c5d74db879abf3d428e4abdd485d338a.r2.cloudflarestorage.com
R2_BUCKET=mizan-quran-assets
R2_REGION=auto
# Engineering safety ceiling. Default is 9 GiB; never configure above the 10 GiB project free-tier ceiling.
MIZAN_R2_SAFETY_LIMIT_BYTES=9663676416

# Quran Intelligence runtime metadata (server-side only). Keep outside public/static paths.
MIZAN_QURAN_INTELLIGENCE_DIR=./.mizan-data/quran-intelligence
# Optional Quran-specific streaming forced-alignment backend. This is SHADOW ONLY in MIZAN.
# Do not configure a general-purpose STT endpoint here. The backend must return reading-scoped Quran loci/confidence.
MIZAN_QURAN_ALIGNMENT_URL=
MIZAN_QURAN_ALIGNMENT_BEARER_TOKEN=

# ── تعدّد الجهات والنطاقات ──────────────────────────────────────────────
# نشرٌ واحد يخدم كل الجهات، والمضيف هو ما يميّز الجهة.
# النطاق الأساسي الذي تتفرّع منه نطاقات الجهات (jamiat-x.mizan.app):
MIZAN_BASE_DOMAIN=
# سجل الجهات: إمّا ملف JSON…
MIZAN_TENANTS_FILE=
# …أو مضمّنًا. مثال:
# MIZAN_TENANTS=[{"orgId":"org-a","subdomain":"jamiat-a","displayNameArabic":"جهة أ","customDomains":["quran.jamiat-a.org"]}]
MIZAN_TENANTS=

# ── التراخيص والحصص والتخزين متعدد الجهات ─────────────────────────────
# مسار دائم ومشترك لحالة SaaS التجارية. اتركه فارغًا لتعطيل المسارات بدل تشغيل حالة وهمية.
MIZAN_SAAS_DATA_DIR=./.mizan-data/saas

# ── إبلاغ Google بنطاقات الجهات آليًا ──────────────────────────────────
# مفتاح Firebase مقيَّد بمُحيلات HTTP: أي نطاق ليس في قائمته تُرفض طلباته، فيتعطّل النظام
# عند تلك الجهة كليًا بلا رسالة مفهومة. وإدخال كل نطاق يدويًا لا يصلح مع عشرات الجهات.
# بضبط المتغيّرين التاليين يتولّى ميزان إبلاغ Google لحظة اعتماد النطاق من اللوحة.
#
# حساب الخدمة: قيّده على هذا المفتاح وحده لا على المشروع. مفتاحه ملف على الخادم ولا تحقق
# بخطوتين له، فأسوأ ما يحدث عند تسرّبه إضافة نطاق إلى مفتاح واحد لا مساس بالمشروع.
# الصلاحيات: apikeys.keys.get/update على المفتاح، و identitytoolkit للنطاقات المصرّح بها.
MIZAN_GOOGLE_SERVICE_ACCOUNT_JSON=
# المسار الكامل للمفتاح: projects/<project>/locations/global/keys/<id>
MIZAN_FIREBASE_API_KEY_RESOURCE=
# سجل الشهادات العام: يتيح لحامل شهادة مطبوعة أن يتحقق منها بنفسه بلا حساب.
# اتركه فارغًا ويبقى كل شيء يعمل، لكن تحقّق الغرباء من الشهادات لن يعمل.
MIZAN_CERTIFICATE_REGISTRY_DIR=./.mizan-data/certificates
# حدود اختيارية لنقاط الشهادات (لها قيم افتراضية معقولة: 60 و300 في الدقيقة).
MIZAN_CERTIFICATE_VERIFY_RATE_LIMIT_MAX=
MIZAN_CERTIFICATE_PUBLISH_RATE_LIMIT_MAX=
MIZAN_PUBLIC_REGISTRATION_RATE_LIMIT_MAX=12
# تدقيق النطاق على الخادم (scope-verification): طلبات في الدقيقة لكل عنوان. الافتراضي 60.
MIZAN_ENTERPRISE_AUDIT_RATE_LIMIT_MAX=
# قاعدة Firestore التي يستخدمها خادم التسجيل العام. اتركها فارغة لاستخدام (default).
FIRESTORE_DATABASE_ID=
# مفتاح خادمي بطول 24 حرفًا على الأقل. خزنة أسرار التخزين فقط؛ لا تضعه في VITE_ أو Git.
MIZAN_STORAGE_SECRET_MASTER_KEY=

# ── صوت عبارة إنهاء الموضع (غير قرآنية) ────────────────────────────────
# تُولَّد المقاطع مرة واحدة إلى public/audio/cues عبر:
#   MIZAN_GEMINI_API_KEY=... node scripts/generate-cue-audio.mjs
# ويمكن أيضًا توليدها عند الطلب على الخادم إن ضُبط المفتاح.
MIZAN_GEMINI_API_KEY=
MIZAN_CUE_TTS_MODEL=gemini-2.5-flash-preview-tts
MIZAN_CUE_TTS_VOICE=Kore
