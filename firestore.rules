rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roleIs(roles) { return signedIn() && request.auth.token.role in roles; }
    function platformAdmin() { return signedIn() && request.auth.token.role == 'super_admin'; }
    function sameOrg(orgId) { return signedIn() && (platformAdmin() || request.auth.token.org_id == orgId); }

    // Organization-wide identities may move across competitions in the same tenant.
    // Every operational competition role is fail-closed unless the Firebase claim names
    // the exact competition. Platform owner remains global by design.
    // Identity binding on uploaded documents compares request.auth.uid to the
    // `uploaderUid` field stamped by the client at upload time. Domain fields such as
    // actorId/judgeId/participantId hold Mizan registry ids (usr-...), never Firebase
    // UIDs — comparing those to request.auth.uid denies every write for every role.
    function requiresCompetitionClaim() {
      return roleIs([
        'comp_admin','head_judge','judge','ops_manager','exception_host',
        'delegation_manager','participant','broadcast_operator','auditor','guardian'
      ]);
    }
    function compScope(competitionId) {
      return platformAdmin()
        || !requiresCompetitionClaim()
        || (('competition_id' in request.auth.token) && request.auth.token.competition_id == competitionId)
        || (('competition_ids' in request.auth.token) && request.auth.token.competition_ids != null
          && competitionId in request.auth.token.competition_ids);
    }
    function scoped(orgId, competitionId) { return sameOrg(orgId) && compScope(competitionId); }

    function competitionExists(orgId, competitionId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId)/competitions/$(competitionId));
    }
    function competitionClosed(orgId, competitionId) {
      return competitionExists(orgId, competitionId)
        && get(/databases/$(database)/documents/organizations/$(orgId)/competitions/$(competitionId)).data.competition.status in ['completed','archived'];
    }
    function competitionOpen(orgId, competitionId) {
      return competitionExists(orgId, competitionId) && !competitionClosed(orgId, competitionId);
    }

    // Once closed, all operational identities lose both read and write access.
    // Only platform/organization administration and the independent auditor keep archive visibility.
    function archiveReader(orgId, competitionId) {
      return scoped(orgId, competitionId) && roleIs(['super_admin','org_admin','auditor']);
    }
    function readableScope(orgId, competitionId) {
      return scoped(orgId, competitionId) && (competitionOpen(orgId, competitionId) || archiveReader(orgId, competitionId));
    }
    function writeScope(orgId, competitionId) {
      return scoped(orgId, competitionId) && competitionOpen(orgId, competitionId);
    }
    function admin(orgId, competitionId) {
      return scoped(orgId, competitionId) && roleIs(['super_admin','org_admin','comp_admin']);
    }
    function closingTransition() {
      return request.resource.data.competition.status in ['completed','archived']
        && request.resource.data.competition.status != resource.data.competition.status;
    }

    // Public registration/landing projection. Anonymous visitors only read it.
    match /public_competitions/{competitionId} {
      allow read: if true;
      allow create: if signedIn()
        && roleIs(['super_admin','org_admin','comp_admin'])
        && competitionId != 'comp-pending-setup'
        && request.resource.data.organizationId != 'org-pending-setup'
        && (request.auth.token.role == 'super_admin' || request.resource.data.organizationId == request.auth.token.org_id)
        && request.resource.data.competition.id == competitionId
        && (roleIs(['super_admin','org_admin']) || !(request.resource.data.competition.status in ['completed','archived']));
      allow update: if signedIn()
        && roleIs(['super_admin','org_admin','comp_admin'])
        && competitionId != 'comp-pending-setup'
        && request.resource.data.organizationId != 'org-pending-setup'
        && (request.auth.token.role == 'super_admin' || request.resource.data.organizationId == request.auth.token.org_id)
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.competition.id == competitionId
        && (
          roleIs(['super_admin','org_admin'])
          || (!(resource.data.competition.status in ['completed','archived'])
            && !(request.resource.data.competition.status in ['completed','archived']))
        );
      allow delete: if signedIn() && roleIs(['super_admin','org_admin'])
        && (platformAdmin() || resource.data.organizationId == request.auth.token.org_id);
    }

    // Capability-link journey projection. The key is the hash of an opaque random token.
    // A stale document is still unreadable after the competition closes, even if a client
    // failed to write revoked=true before the root competition status changed.
    match /public_journeys/{tokenHash} {
      // Student and guardian access is resolved by the server API. Anonymous
      // clients cannot read even a hashed capability document directly.
      allow get: if signedIn()
        && scoped(resource.data.organizationId, resource.data.competitionId)
        && roleIs(['super_admin','org_admin','comp_admin','head_judge','ops_manager','exception_host','delegation_manager'])
        && resource.data.revoked != true
        && competitionOpen(resource.data.organizationId, resource.data.competitionId);
      allow list: if false;
      allow create: if signedIn()
        && roleIs(['super_admin','org_admin','comp_admin','head_judge','ops_manager','exception_host','delegation_manager'])
        && request.resource.data.competitionId != 'comp-pending-setup'
        && request.resource.data.organizationId != 'org-pending-setup'
        && sameOrg(request.resource.data.organizationId)
        && compScope(request.resource.data.competitionId)
        && competitionOpen(request.resource.data.organizationId, request.resource.data.competitionId);
      allow update: if signedIn()
        && roleIs(['super_admin','org_admin','comp_admin','head_judge','ops_manager','exception_host','delegation_manager'])
        && request.resource.data.competitionId != 'comp-pending-setup'
        && request.resource.data.organizationId != 'org-pending-setup'
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.competitionId == resource.data.competitionId
        && sameOrg(resource.data.organizationId)
        && compScope(resource.data.competitionId)
        && competitionOpen(resource.data.organizationId, resource.data.competitionId);
      allow delete: if false;
    }

    match /organizations/{orgId} {
      allow read: if sameOrg(orgId);
      allow create, update: if sameOrg(orgId) && roleIs(['super_admin','org_admin']);
      allow delete: if platformAdmin();

      match /competitions/{competitionId} {
        allow read: if readableScope(orgId, competitionId);
        allow create: if admin(orgId, competitionId);
        // Org admin may perform the one-way closure. Competition staff cannot close themselves,
        // and after closure only the platform owner may change the root document (for exceptional recovery).
        allow update: if admin(orgId, competitionId)
          && (
            (competitionOpen(orgId, competitionId) && (!closingTransition() || roleIs(['super_admin','org_admin'])))
            || platformAdmin()
          );
        allow delete: if platformAdmin();

        match /participants/{participantId} {
          allow read: if readableScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge','judge','ops_manager','exception_host','delegation_manager','auditor']);
          allow create, update: if writeScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','exception_host','delegation_manager']);
          allow delete: if false;
        }
        match /judge_events/{eventId} {
          allow read: if readableScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge','judge','auditor']);
          allow create: if writeScope(orgId,competitionId) && roleIs(['judge']);
          allow update, delete: if false;
        }
        match /judge_submissions/{submissionId} {
          allow read: if (readableScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge','auditor']))
            || (readableScope(orgId,competitionId) && roleIs(['judge']) && resource.data.uploaderUid == request.auth.uid);
          allow create: if writeScope(orgId,competitionId) && roleIs(['judge']) && request.resource.data.uploaderUid == request.auth.uid;
          // The client rewrites the same document id when a draft becomes committed,
          // so the owning judge may update their own submission while the competition is open.
          allow update: if writeScope(orgId,competitionId) && roleIs(['judge'])
            && resource.data.uploaderUid == request.auth.uid
            && request.resource.data.uploaderUid == request.auth.uid;
          allow delete: if false;
        }
        match /checkins/{participantId} {
          allow read: if readableScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','ops_manager','exception_host']);
          allow create, update: if writeScope(orgId,competitionId) && roleIs(['comp_admin','ops_manager','exception_host']);
          allow delete: if false;
        }
        match /reviews/{reviewId} {
          allow read: if readableScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge','auditor']);
          allow create, update: if writeScope(orgId,competitionId) && roleIs(['head_judge','comp_admin']);
          allow delete: if false;
        }
        match /results/{resultId} {
          allow read: if readableScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge','judge','auditor']);
          allow create, update: if writeScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge']);
          allow delete: if false;
        }
        match /certificates/{certificateId} {
          allow read: if readableScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','auditor']);
          allow create: if writeScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin']);
          allow update, delete: if false;
        }
        match /committees/{committeeId} {
          allow read: if readableScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge','judge','ops_manager','exception_host','delegation_manager','auditor']);
          allow create, update: if writeScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','ops_manager']);
          allow delete: if writeScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','ops_manager']);
        }
        match /appeals/{appealId} {
          allow read: if readableScope(orgId,competitionId)
            && (roleIs(['super_admin','org_admin','comp_admin','head_judge','auditor','support_agent'])
              || (roleIs(['participant','guardian']) && resource.data.uploaderUid == request.auth.uid));
          allow create: if writeScope(orgId,competitionId)
            && (roleIs(['super_admin','org_admin','comp_admin','head_judge','support_agent'])
              || (roleIs(['participant','guardian']) && request.resource.data.uploaderUid == request.auth.uid));
          // The client re-syncs every record its role owns, so a filer's own appeal is
          // rewritten under the same doc id; without this clause every re-sync is denied.
          allow update: if writeScope(orgId,competitionId)
            && (roleIs(['super_admin','org_admin','comp_admin','head_judge'])
              || (roleIs(['participant','guardian','support_agent'])
                && resource.data.uploaderUid == request.auth.uid
                && request.resource.data.uploaderUid == request.auth.uid));
          allow delete: if false;
        }
        match /support_sessions/{supportId} {
          allow read: if readableScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','support_agent','ops_manager','head_judge']);
          allow create: if writeScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','ops_manager','head_judge','support_agent']);
          allow update: if writeScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','support_agent']);
          allow delete: if false;
        }
        // نطاق المتسابق المعتمد: المتسابق يكتب اختياره وحده، والإدارة تعتمده.
        // القراءة مفتوحة لمن يدير المسابقة ويحكّمها ويدقّقها، لا للعموم.
        match /participant_scopes/{scopeId} {
          allow read: if readableScope(orgId,competitionId)
            && (roleIs(['super_admin','org_admin','comp_admin','head_judge','judge','ops_manager','delegation_manager','auditor'])
              || (roleIs(['participant','guardian']) && resource.data.uploaderUid == request.auth.uid));
          allow create: if writeScope(orgId,competitionId)
            && (roleIs(['super_admin','org_admin','comp_admin','delegation_manager'])
              || (roleIs(['participant']) && request.resource.data.uploaderUid == request.auth.uid));
          allow update: if writeScope(orgId,competitionId)
            && (roleIs(['super_admin','org_admin','comp_admin','delegation_manager'])
              || (roleIs(['participant'])
                && resource.data.uploaderUid == request.auth.uid
                && request.resource.data.uploaderUid == request.auth.uid
                && resource.data.status in ['draft','submitted','rejected']));
          allow delete: if false;
        }
        match /session_checkpoints/{checkpointId} {
          allow read: if readableScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge','judge','ops_manager','auditor']);
          allow create, update: if writeScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge','judge','ops_manager']);
          allow delete: if false;
        }
        match /quran_sources/{sourceId} {
          allow read: if readableScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge','judge','auditor']);
          allow create, update: if writeScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge']);
          allow delete: if false;
        }
        match /audit/{eventId} {
          allow read: if readableScope(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge','auditor']);
          allow create: if writeScope(orgId,competitionId)
            && roleIs(['super_admin','org_admin','comp_admin','head_judge','judge','ops_manager','exception_host','delegation_manager','broadcast_operator','auditor','support_agent'])
            && request.resource.data.uploaderUid == request.auth.uid;
          allow update, delete: if false;
        }
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
