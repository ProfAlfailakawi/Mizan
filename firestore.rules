rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function sameOrg(orgId) { return signedIn() && request.auth.token.org_id == orgId; }
    function roleIs(roles) { return signedIn() && request.auth.token.role in roles; }
    // Competition-bound roles (a judge) must carry a matching competition_id claim; a missing claim
    // must NOT grant access to every competition in the org. Org-wide roles keep cross-competition scope.
    function compScope(competitionId) {
      return request.auth.token.role == 'judge'
        ? (('competition_id' in request.auth.token) && request.auth.token.competition_id == competitionId)
        : (!('competition_id' in request.auth.token) || request.auth.token.competition_id == competitionId);
    }
    function scoped(orgId, competitionId) { return sameOrg(orgId) && compScope(competitionId); }
    function admin(orgId,competitionId) { return scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin']); }

    match /organizations/{orgId} {
      allow read: if sameOrg(orgId);
      allow create, update: if sameOrg(orgId) && roleIs(['super_admin','org_admin']);
      allow delete: if sameOrg(orgId) && roleIs(['super_admin']);

      match /competitions/{competitionId} {
        allow read: if scoped(orgId,competitionId);
        allow create, update: if admin(orgId,competitionId);
        allow delete: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin']);

        match /participants/{participantId} {
          // A judge must see the contestant in front of them; reading is not authoring.
          allow read: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','scientific_admin','head_judge','judge','ops_manager','exception_host','delegation_manager','auditor']);
          allow create, update: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','exception_host','delegation_manager']);
          allow delete: if false;
        }
        match /judge_events/{eventId} {
          allow read: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','scientific_admin','head_judge','judge','auditor']);
          allow create: if scoped(orgId,competitionId) && roleIs(['judge']);
          allow update, delete: if false;
        }
        match /judge_submissions/{submissionId} {
          allow read: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','scientific_admin','head_judge','auditor']) || (scoped(orgId,competitionId) && roleIs(['judge']) && resource.data.judgeId == request.auth.uid);
          allow create: if scoped(orgId,competitionId) && roleIs(['judge']) && request.resource.data.judgeId == request.auth.uid;
          allow update, delete: if false;
        }
        match /checkins/{participantId} {
          allow read: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','ops_manager','exception_host']);
          allow create, update: if scoped(orgId,competitionId) && roleIs(['comp_admin','ops_manager','exception_host']);
          allow delete: if false;
        }
        match /reviews/{reviewId} {
          allow read: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','scientific_admin','head_judge','auditor']);
          allow create, update: if scoped(orgId,competitionId) && roleIs(['head_judge','scientific_admin']);
          allow delete: if false;
        }
        match /results/{resultId} {
          allow read: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','scientific_admin','head_judge','judge','auditor']);
          allow create, update: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge']);
          allow delete: if false;
        }
        match /certificates/{certificateId} {
          allow read: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','auditor']);
          allow create: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin']);
          allow update, delete: if false;
        }
        match /committees/{committeeId} {
          // Panel composition is operational structure: administrators author it, the panel reads it.
          allow read: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','scientific_admin','head_judge','judge','ops_manager','exception_host','delegation_manager','auditor']);
          allow create, update: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','ops_manager']);
          allow delete: if false;
        }
        match /appeals/{appealId} {
          // A contestant may raise and read their own appeal; the panel and administration see all.
          allow read: if scoped(orgId,competitionId) && (roleIs(['super_admin','org_admin','comp_admin','scientific_admin','head_judge','auditor','support_agent']) || (roleIs(['participant','guardian']) && resource.data.participantId == request.auth.uid));
          allow create: if scoped(orgId,competitionId) && (roleIs(['super_admin','org_admin','comp_admin','head_judge','support_agent']) || (roleIs(['participant','guardian']) && request.resource.data.participantId == request.auth.uid));
          allow update: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge']);
          allow delete: if false;
        }
        match /session_checkpoints/{checkpointId} {
          allow read: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge','judge','ops_manager','auditor']);
          allow create, update: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','head_judge','judge','ops_manager']);
          allow delete: if false;
        }
        match /quran_sources/{sourceId} {
          allow read: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','scientific_admin','head_judge','judge','auditor']);
          allow create, update: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','scientific_admin']);
          allow delete: if false;
        }
        match /audit/{eventId} {
          allow read: if scoped(orgId,competitionId) && roleIs(['super_admin','org_admin','comp_admin','scientific_admin','head_judge','auditor']);
          // Audit rows must be attributable: only provisioned roles may write, and the recorded actor
          // must equal the authenticated caller so no one can forge another user's actions.
          allow create: if scoped(orgId,competitionId)
            && roleIs(['super_admin','org_admin','comp_admin','scientific_admin','head_judge','judge','ops_manager','exception_host','delegation_manager','broadcast_operator','auditor','support_agent'])
            && request.resource.data.actorId == request.auth.uid;
          allow update, delete: if false;
        }
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
